APP_NAME=TallCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tallcms
DB_USERNAME=root
DB_PASSWORD=

# Required only when running `php artisan db:seed`.
TALLCMS_ADMIN_USERNAME=admin
TALLCMS_ADMIN_FIRST_NAME=Administrator
TALLCMS_ADMIN_LAST_NAME=
TALLCMS_ADMIN_EMAIL=admin@example.test
TALLCMS_ADMIN_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.test"
MAIL_FROM_NAME="${APP_NAME}"
